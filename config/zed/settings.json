// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "minimum_split_diff_width": 100.0,
  "diff_view_style": "split",
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "acceptEdits"
      },
      "favorite_config_option_values": {
        "mode": [
          "acceptEdits"
        ]
      },
      "type": "registry"
    }
  },
  "edit_predictions": {
    "ollama": {
      "max_output_tokens": 64,
      "api_url": "http://localhost:11434",
    },
    "provider": "copilot",
  },
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "terminal": {
    "font_family": "MonoLisaCode Trial",
    "font_size": 16.0,
  },
  "base_keymap": "VSCode",
  "buffer_font_fallbacks": [
    "Fira Code",
    "Comic Mono",
    "Anonymous Pro",
    "NovaMono",
    "Menlo",
    "Monaco",
    "Courier New",
    "monospace",
  ],
  "buffer_font_family": "MonoLisaCode Trial",
  "file_types": {
    "javascript": ["*.gs"],
  },
  "auto_indent_on_paste": true,
  "icon_theme": "Zed (Default)",
  "ui_font_size": 20.0,
  "buffer_font_size": 22.0,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
  "agent": {
    "play_sound_when_agent_done": "always",
    "enable_feedback": false,
    "dock": "right",
    "enabled": true, // Master switch for all AI features
    "button": true, // Show agent panel button in status bar
  },
  "languages": {
    "Shell Script": {
      "language_servers": ["bash-language-server"],
    },
  },
}
