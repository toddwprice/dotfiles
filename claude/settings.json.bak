{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "figma@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": false,
    "playground@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "linear@claude-plugins-official": false,
    "slack@claude-plugins-official": true,
    "org-pulse@dscout-claude-plugins": false,
    "astro@dscout-claude-plugins": true,
    "dscout-data-mcp@dscout-claude-plugins": true,
    "imessage@claude-plugins-official": false,
    "pydantic-ai@claude-plugins-official": true,
    "axon@dscout-claude-plugins": true,
    "dev-flow@dscout-claude-plugins": true,
    "bug-intel@dscout-claude-plugins": true,
    "dscout-quality@dscout-claude-plugins": true,
    "warp@claude-code-warp": true,
    "understand-anything@understand-anything": true,
    "agent-skills@addy-agent-skills": false
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Egonex-AI/Understand-Anything"
      }
    },
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    }
  },
  "effortLevel": "xhigh",
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "light-daltonized",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "autoScrollEnabled": false,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true
}
