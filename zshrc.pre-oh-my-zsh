autoload -U +X bashcompinit && bashcompinit


# Set badge to show the current session name and git branch, if any is set.
printf "\e]1337;SetBadgeFormat=%s\a" \
  $(echo -n "\(session.name) \(user.gitBranch)" | base64)

# Load environment variables from ~/.env file
source ~/.env

# Start Claude Code with official Anthropic models (Default)
ccc() {
    unset ANTHROPIC_BASE_URL
    unset ANTHROPIC_AUTH_TOKEN
    claude "$@"
}

# Start Claude Code with GLM models via Z.ai backend
ccglm() {
    # Point to the GLM provider's Anthropic-compatible endpoint
    export ANTHROPIC_BASE_URL="https://api.z.ai/api/anthropic"
    export ANTHROPIC_AUTH_TOKEN="${ZAI_AUTH_TOKEN:?Set ZAI_AUTH_TOKEN in ~/.env}"
    export ANTHROPIC_MODEL="glm-4.7"
    claude "$@"
}

