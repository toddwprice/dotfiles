#!/usr/bin/env bash
#
# prs — open pull requests waiting for my review, with the associated Linear
# issue rather than the PR title. GitHub is the source for review state and
# creation time; Linear is the source for the ticket title.

set -euo pipefail

ORG="dscout"
REPO=""
LIMIT=100
SKIP_DRAFTS=false
PR_REF_WIDTH=32
SUBMITTER_WIDTH=18
LINEAR_WIDTH=64

# Bash printf measures its field widths in UTF-8 bytes, not the terminal cells
# they occupy. Format each column by display width instead, so an em dash in a
# Linear title (and the ASCII truncation marker) cannot shift Created left or
# right. Perl ships with macOS and its Unicode properties cover wide glyphs.
format_column() {
  local value="$1"
  local max_length="$2"

  perl -CSDA -e '
    sub cell_width {
      my ($character) = @_;
      return 0 if $character =~ /\p{Mark}/ || $character eq "\x{200D}";
      return $character =~ /\p{East_Asian_Width=Wide}/ ||
        $character =~ /\p{East_Asian_Width=Fullwidth}/ ? 2 : 1;
    }

    sub display_width { my $width = 0; $width += cell_width($_) for split //, $_[0]; return $width; }

    my ($value, $max_width) = @ARGV;
    if (display_width($value) > $max_width) {
      my ($width, @characters) = (0);
      for my $character (split //, $value) {
        my $character_width = cell_width($character);
        last if $width + $character_width > $max_width - 3;
        push @characters, $character;
        $width += $character_width;
      }
      $value = join("", @characters) . "...";
    }

    my $padding = $max_width - display_width($value);
    print $value, " " x ($padding > 0 ? $padding : 0);
  ' "$value" "$max_length"
}

format_created_at() {
  local created_at="$1"
  local epoch formatted

  # GitHub timestamps are UTC. Parse them in UTC first, then let date render
  # the resulting instant in this machine's current timezone.
  epoch="$(TZ=UTC date -j -f '%Y-%m-%dT%H:%M:%SZ' "$created_at" '+%s')" || return 1
  formatted="$(date -r "$epoch" '+%a %b %-d %-I:%M%p (%Z)')" || return 1
  formatted="${formatted/AM/am}"
  printf '%s' "${formatted/PM/pm}"
}

usage() {
  cat <<'EOF'
Usage: prs [options]

Lists open PRs that have requested your review, oldest first.

  #       GitHub PR number
  Submitter  GitHub author
  Linear  Linear ticket and its current title
  Created  When the PR was opened (your current timezone)

Options:
  -r, --repo OWNER/NAME  Search one repo instead of the dscout organization
  -a, --all-repos        Search every repo you can access
  -n, --limit N          Max PRs to return (default: 100)
  -d, --no-drafts        Leave draft PRs out
  -h, --help             Show this help
EOF
}

die() { echo "prs: $*" >&2; exit 2; }
need_value() { [[ $# -ge 2 && -n "${2:-}" ]] || die "$1 needs a value"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    -r|--repo)      need_value "$@"; REPO="$2"; ORG=""; shift 2 ;;
    -a|--all-repos) REPO=""; ORG=""; shift ;;
    -n|--limit)     need_value "$@"; LIMIT="$2"; shift 2 ;;
    -d|--no-drafts) SKIP_DRAFTS=true; shift ;;
    -h|--help)      usage; exit 0 ;;
    *)              die "unknown option '$1'" ;;
  esac
done

[[ "$LIMIT" =~ ^[0-9]+$ && "$LIMIT" -gt 0 ]] || die "--limit must be a positive number (got '$LIMIT')"
[[ -z "$REPO" || "$REPO" == */* ]] || die "--repo must look like OWNER/NAME (got '$REPO')"

for tool in gh jq linctl; do
  command -v "$tool" >/dev/null 2>&1 || die "'$tool' not found on PATH"
done

gh auth status >/dev/null 2>&1 || die "gh is not authenticated; run: gh auth login"
linctl auth status >/dev/null 2>&1 || die "linctl is not authenticated; run: linctl auth"

qualifiers=("archived:false")
[[ -n "$REPO" ]] && qualifiers+=("repo:$REPO")
[[ -n "$ORG" ]] && qualifiers+=("org:$ORG")

if ! json="$(gh search prs "${qualifiers[@]}" \
    --review-requested=@me \
    --state=open \
    --sort=created \
    --order=asc \
    --limit "$LIMIT" \
    --json number,repository,isDraft,title,author,createdAt)"; then
  die "GitHub PR search failed"
fi

if [[ "$SKIP_DRAFTS" == true ]]; then
  json="$(jq '[.[] | select(.isDraft | not)]' <<<"$json")"
fi

count="$(jq 'length' <<<"$json")"
if [[ "$count" -eq 0 ]]; then
  if [[ -n "$REPO" ]]; then
    scope=" in $REPO"
  elif [[ -n "$ORG" ]]; then
    scope=" in the $ORG organization"
  else
    scope=""
  fi
  echo "No open PRs are waiting for your review$scope."
  exit 0
fi

printf '\033[1m%s %s %s %s\033[0m\n' \
  "$(format_column '#' "$PR_REF_WIDTH")" \
  "$(format_column 'Submitter' "$SUBMITTER_WIDTH")" \
  "$(format_column 'Linear' "$LINEAR_WIDTH")" \
  'Created'

while IFS=$'\t' read -r number author pr_title created repo; do
  # PR titles conventionally carry the Linear identifier, e.g. [FRG-1234] or
  # FRG-1234: title. The Linear title is intentionally fetched fresh instead
  # of echoing the PR title, which often describes the implementation instead.
  if [[ "$pr_title" =~ ([[:alpha:]][[:alnum:]]*-[0-9]+) ]]; then
    ticket="${BASH_REMATCH[1]^^}"
    if issue="$(linctl issue get "$ticket" --json 2>/dev/null)"; then
      ticket_title="$(jq -r '.title // empty' <<<"$issue")"
      linear="$ticket — $ticket_title"
    else
      linear="$ticket — not found in Linear"
    fi
  else
    linear='— no Linear ticket in PR title'
  fi

  # A bare number only identifies a PR within one repository. Keep the normal
  # output short, but qualify it when --all-repos broadens that scope.
  if [[ -n "$REPO" ]]; then
    pr_ref="#$number"
  else
    pr_ref="$repo#$number"
  fi

  if ! created="$(format_created_at "$created")"; then
    die "could not format GitHub creation time '$created'"
  fi

  printf '%s %s %s %s\n' \
    "$(format_column "$pr_ref" "$PR_REF_WIDTH")" \
    "$(format_column "@$author" "$SUBMITTER_WIDTH")" \
    "$(format_column "$linear" "$LINEAR_WIDTH")" \
    "$created"
done < <(jq -r '.[] | [
  (.number | tostring),
  (.author.login // "ghost"),
  .title,
  .createdAt,
  .repository.nameWithOwner
] | @tsv' <<<"$json")
